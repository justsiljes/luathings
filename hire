--[[
   Full Head & Accessories Swapper + Universal Mesh Fix
   Press 'P' to Toggle On/Off
]]

_G.HeadSize = 2.3
_G.Enabled = false

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer

local TOGGLE_KEY = Enum.KeyCode.P

local originalHeadData = {}
local processedPlayers = {}

local function applyFullHeadFix(targetPlayer)
    local char = targetPlayer.Character
    if not char then return end
    
    local head = char:FindFirstChild("Head")
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not head or not humanoid then return end

    if processedPlayers[targetPlayer] then
        head.Size = Vector3.new(_G.HeadSize, _G.HeadSize, _G.HeadSize)
        head.CanCollide = false
        return
    end

    -- حفظ البيانات الأصلية للاعب
    if not originalHeadData[targetPlayer] then
        originalHeadData[targetPlayer] = {
            Size = head.Size,
            Color = head.Color,
            Transparency = head.Transparency,
            Material = head.Material,
            Mesh = head:FindFirstChildOfClass("SpecialMesh") and head:FindFirstChildOfClass("SpecialMesh"):Clone() or nil,
            Decal = head:FindFirstChildOfClass("Decal") and head:FindFirstChildOfClass("Decal"):Clone() or nil
        }
    end

    processedPlayers[targetPlayer] = true

    task.spawn(function()
        pcall(function()
            local desc = Players:GetHumanoidDescriptionFromUserId(targetPlayer.UserId)
            local dummyModel = Players:CreateHumanoidModelFromDescription(desc, humanoid.RigType)
            local dummyHead = dummyModel:FindFirstChild("Head")

            if dummyHead and char:FindFirstChild("Head") then
                -- 1. نقل لون وخامة الرأس
                head.Color = dummyHead.Color
                head.Material = dummyHead.Material

                -- 2. نقل الوجه الأصلي
                local dFace = dummyHead:FindFirstChildOfClass("Decal")
                local tFace = head:FindFirstChildOfClass("Decal")
                if dFace then
                    if tFace then 
                        tFace.Texture = dFace.Texture 
                        tFace.Transparency = 0
                    else 
                        dFace:Clone().Parent = head 
                    end
                end

                -- 3. مسح أي مش قديم لمنع التداخل أو التشوه المكعب
                for _, child in pairs(head:GetChildren()) do
                    if child:IsA("SpecialMesh") or child:IsA("CharacterMesh") then
                        child:Destroy()
                    end
                end

                -- 4. إجبار الرأس على أخذ مجسم الرأس البيضاوي القياسي الموحد
                local dMesh = dummyHead:FindFirstChildOfClass("SpecialMesh") or dummyHead:FindFirstChildOfClass("Mesh")
                if dMesh and dMesh:IsA("SpecialMesh") and dMesh.MeshId ~= "" then
                    dMesh:Clone().Parent = head
                else
                    -- إنشاء رأس انسيابي موحد يدعم جميع السكنات الكلاسيكية والمكعبة
                    local fixedMesh = Instance.new("SpecialMesh")
                    fixedMesh.MeshType = Enum.MeshType.Head
                    fixedMesh.Scale = Vector3.new(1.25, 1.25, 1.25)
                    fixedMesh.Parent = head
                end

                -- 5. نقل كافة الإكسسوارات والشعر
                for _, item in pairs(dummyModel:GetChildren()) do
                    if item:IsA("Accessory") then
                        local handle = item:FindFirstChild("Handle")
                        if handle then
                            local att = handle:FindFirstChildOfClass("Attachment")
                            if att and (att.Name:find("Hat") or att.Name:find("Hair") or att.Name:find("Face") or att.Name:find("Head")) then
                                if not char:FindFirstChild(item.Name) then
                                    local cloneAcc = item:Clone()
                                    cloneAcc.Parent = char
                                end
                            end
                        end
                    end
                end
            end
            dummyModel:Destroy()
        end)
    end)

    -- تكبير الرأس
    head.Size = Vector3.new(_G.HeadSize, _G.HeadSize, _G.HeadSize)
    head.Transparency = 0
    head.CanCollide = false
end

local function restoreOriginalHead(targetPlayer)
    local data = originalHeadData[targetPlayer]
    local char = targetPlayer.Character
    
    processedPlayers[targetPlayer] = nil
    
    if not char or not data then return end
    
    local head = char:FindFirstChild("Head")
    if head then
        head.Size = data.Size
        head.Color = data.Color
        head.Transparency = data.Transparency
        head.Material = data.Material

        for _, child in pairs(head:GetChildren()) do
            if child:IsA("SpecialMesh") or child:IsA("CharacterMesh") then
                child:Destroy()
            end
        end
        if data.Mesh then data.Mesh:Clone().Parent = head end

        local currentDecal = head:FindFirstChildOfClass("Decal")
        if currentDecal then currentDecal:Destroy() end
        if data.Decal then data.Decal:Clone().Parent = head end
    end
    
    originalHeadData[targetPlayer] = nil
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == TOGGLE_KEY then
        _G.Enabled = not _G.Enabled
        
        if not _G.Enabled then
            for _, v in pairs(Players:GetPlayers()) do
                if v ~= LocalPlayer then
                    pcall(function()
                        restoreOriginalHead(v)
                    end)
                end
            end
        end
    end
end)

RunService.RenderStepped:Connect(function()
    if _G.Enabled then
        for _, v in pairs(Players:GetPlayers()) do
            if v ~= LocalPlayer and v.Character and v.Character:FindFirstChild("Head") then
                pcall(function()
                    applyFullHeadFix(v)
                end)
            end
        end
    end
end)
